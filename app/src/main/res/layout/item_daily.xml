<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDayEmoji"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="☀️"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDayRain"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#9FD8FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDayMin"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:gravity="end"
        android:text="--°"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_track"
        android:orientation="horizontal">

        <View
            android:id="@+id/rangeSpaceStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0" />

        <View
            android:id="@+id/rangeFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_range_fill" />

        <View
            android:id="@+id/rangeSpaceEnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDayMax"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="--°"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>